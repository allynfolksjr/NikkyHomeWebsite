<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nikky Southerland: engineering, photography, blogging, and life in Philadelphia." />
    <meta name="theme-color" content="#39275b" />

    <title><%= content_for?(:title) ? yield(:title) : "Nikky Southerland" %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sanchez:ital@0;1&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <%= stylesheet_link_tag    "application" %>
    <%= javascript_include_tag "application" %>
    <%= csrf_meta_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <main id="main-content">
      <%= yield %>
    </main>

    <footer class="purple">
      <div class="row"><div class="small-12"><small>
        Site created by Nikky Southerland with help from
        <a href="https://rubyonrails.org" target="_blank" rel="noopener noreferrer">Ruby on Rails</a>,
        <a href="https://get.foundation/" target="_blank" rel="noopener noreferrer">ZURB Foundation</a>, and
        <a href="https://fontawesome.com" target="_blank" rel="noopener noreferrer">Font Awesome 6</a>.
      </small></div></div>
    </footer>

  </body>
</html>
